{
  "name": "@alguna/sdk",
  "version": "0.4.0",
  "description": "Official TypeScript SDK for the Alguna Public API",
  "license": "Apache-2.0",
  "author": "Alguna",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://alguna.com/docs",
  "keywords": [
    "alguna",
    "billing",
    "subscriptions",
    "invoicing",
    "payments"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "email": "support@alguna.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alguna-io/alguna-ts.git"
  }
}
